+/*
+ * ic_vap_delete wrapper.  The AP and age tasks find the access point
+ * vap by walking ic_vaps on taskqueue_thread, which vap teardown does
+ * not drain.  Mark the vap as going so they pass it over, drain them,
+ * and only then let the driver delete it.  The saved hooks are
+ * dropped last, since the vap's trip to INIT still uses them.
+ */
+static void
+fmac_vap_delete(struct ieee80211vap *vap)
+{
+	struct ieee80211com *ic = vap->iv_ic;
+	struct fmac_state *fs = fmac_lookup(ic);
+	void (*del)(struct ieee80211vap *);
+
+	if (fs == NULL) {
+		/* Not reached: detach puts ic_vap_delete back first. */
+		fmac_vap_forget(vap);
+		return;
+	}
+	del = fs->fs_save_vap_delete;
+	mtx_lock(&fs->fs_ap_mtx);
+	fs->fs_vap_going = vap;
+	mtx_unlock(&fs->fs_ap_mtx);
+	taskqueue_drain(taskqueue_thread, &fs->fs_ap_task);
+	callout_drain(&fs->fs_age_callout);
+	taskqueue_drain(taskqueue_thread, &fs->fs_age_task);
+	callout_drain(&fs->fs_age_callout);
+	fmac_release(fs);
+
+	del(vap);
+	fmac_vap_forget(vap);
+
+	if ((fs = fmac_lookup(ic)) != NULL) {
+		mtx_lock(&fs->fs_ap_mtx);
+		if (fs->fs_vap_going == vap)
+			fs->fs_vap_going = NULL;
+		mtx_unlock(&fs->fs_ap_mtx);
+		fmac_release(fs);
+	}
+}
