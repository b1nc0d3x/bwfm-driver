 		}
 	}
 	mtx_unlock(&fmac_mtx);
 
 	/*
-	 * Restore saved ic slots.  Safe outside fmac_mtx because
-	 * every reader that could have raced us just released its ref.
+	 * Restore saved ic slots and every vap's hooks.  Safe outside
