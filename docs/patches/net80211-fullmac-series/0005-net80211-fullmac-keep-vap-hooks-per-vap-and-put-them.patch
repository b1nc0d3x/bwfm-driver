+/*
+ * Each vap's own net80211 hooks, saved when the framework rewires
+ * them.  Kept per vap (a station and an access point have different
+ * iv_newstate) and on a global list under fmac_mtx, apart from
+ * fmac_state, so the shims can always reach the hooks they replaced,
+ * even while the framework detaches.
+ */
+struct fmac_vap {
+	LIST_ENTRY(fmac_vap)	fv_link;
+	struct ieee80211vap	*fv_vap;
+	int	(*fv_newstate)(struct ieee80211vap *, enum ieee80211_state,
+		    int);
+	int	(*fv_key_set)(struct ieee80211vap *,
+		    const struct ieee80211_key *);
+	int	(*fv_key_delete)(struct ieee80211vap *,
+		    const struct ieee80211_key *);
+	int	(*fv_reset)(struct ieee80211vap *, u_long);
+	bool	fv_ioctl;		/* if_ioctl replaced */
+};
