-			    fs->fs_save_scan_start, fs->fs_save_key_set);
-			/*
-			 * Link it back (it was unlinked above), then
-			 * unlock and bail.  ic slots stay pointing at our
-			 * shims — the caller must not free ic yet.
-			 */
-			fmac_link_locked(fs);
-			mtx_unlock(&fmac_mtx);
-			return;
+			if (++wi % 30 == 0)
+				printf("ieee80211_fmac_detach: still waiting "
