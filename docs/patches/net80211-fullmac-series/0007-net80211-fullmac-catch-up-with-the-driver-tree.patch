+		error = ENOENT;
+	else if (ireq->i_len < len)
+		error = ENOSPC;
+	else {
+		error = copyout(buf, ireq->i_data, len);
+		ireq->i_len = len;
+	}
+	free(buf, M_TEMP);
+	return (error);
