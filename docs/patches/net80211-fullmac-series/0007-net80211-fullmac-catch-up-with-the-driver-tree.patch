+	fs = fmac_lookup(ic);
+	if (fs == NULL)
+		return (ENXIO);
+	buf = malloc(sizeof(fs->fs_assoc_ie), M_TEMP, M_WAITOK);
+	IEEE80211_LOCK(ic);
+	len = fs->fs_assoc_ielen;
+	memcpy(buf, fs->fs_assoc_ie, len);
+	IEEE80211_UNLOCK(ic);
+	fmac_release(fs);
