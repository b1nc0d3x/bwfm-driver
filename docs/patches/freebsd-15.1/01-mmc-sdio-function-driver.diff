+/* set or clear the card interrupt enable; slot mutex held */
+static void
+bcm_sdhci_cardintr_unmask(struct bcm_sdhci_softc *sc, bool on)
+{
+	struct sdhci_slot *slot = &sc->sc_slot;
+
+	uint32_t ien;
+
+	mtx_assert(&slot->mtx, MA_OWNED);
+	if (on)
+		slot->intmask |= SDHCI_INT_CARD_INT;
+	else
+		slot->intmask &= ~SDHCI_INT_CARD_INT;
+	/*
+	 * Change only the card-interrupt bit in INT_ENABLE.  During a
+	 * transfer the core narrows slot->intmask and writes it to
+	 * SIGNAL_ENABLE alone, keeping INT_ENABLE broader so the command's
+	 * completion status still latches; writing slot->intmask to
+	 * INT_ENABLE here would drop those bits and time the command out.
+	 */
+	ien = bcm_sdhci_read_4(sc->sc_dev, slot, SDHCI_INT_ENABLE);
+	ien = on ? (ien | SDHCI_INT_CARD_INT) : (ien & ~SDHCI_INT_CARD_INT);
+	bcm_sdhci_write_4(sc->sc_dev, slot, SDHCI_INT_ENABLE, ien);
+	bcm_sdhci_write_4(sc->sc_dev, slot, SDHCI_SIGNAL_ENABLE,
+	    slot->intmask);
