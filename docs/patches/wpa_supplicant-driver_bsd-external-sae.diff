+/* External SAE: our Authentication frames, whole, header included. */
+static int
+wpa_driver_bsd_send_mlme(void *priv, const u8 *data, size_t data_len,
+			 int noack, unsigned int freq, const u16 *csa_offs,
+			 size_t csa_offs_len, int no_encrypt,
+			 unsigned int wait, int link_id)
+{
+	struct bsd_driver_data *drv = priv;
+
+	return set80211var(drv, IEEE80211_IOC_MGMT_TX, data, data_len);
+}
+
+static int
+wpa_driver_bsd_send_external_auth_status(void *priv,
+					 struct external_auth *params)
+{
+	struct bsd_driver_data *drv = priv;
+	struct ieee80211_extauth_status st;
+
+	if (params->bssid == NULL ||
+	    params->ssid_len > sizeof(st.is_ssid))
+		return -1;
+	os_memset(&st, 0, sizeof(st));
+	os_memcpy(st.is_bssid, params->bssid, ETH_ALEN);
+	st.is_ssid_len = params->ssid_len;
+	if (params->ssid_len)
+		os_memcpy(st.is_ssid, params->ssid, params->ssid_len);
+	wpa_printf(MSG_DEBUG, "%s: " MACSTR " status %u", __func__,
+		   MAC2STR(params->bssid), params->status);
+	return bsd_set80211(drv, IEEE80211_IOC_EXTAUTH_STATUS, params->status,
+			    &st, sizeof(st));
+}
+
+static int
+wpa_driver_bsd_pmkid(struct bsd_driver_data *drv, int op,
+		     struct wpa_pmkid_params *params)
+{
+	struct ieee80211_pmksa_req req;
+
+	os_memset(&req, 0, sizeof(req));
+	if (op != IEEE80211_PMKSA_FLUSH) {
+		/* The firmware keys PMKSAs by BSSID; FILS cache IDs aren't. */
+		if (params->bssid == NULL || params->pmkid == NULL)
+			return -1;
+		os_memcpy(req.ip_bssid, params->bssid, ETH_ALEN);
+		os_memcpy(req.ip_pmkid, params->pmkid, PMKID_LEN);
+	}
+	return bsd_set80211(drv, IEEE80211_IOC_PMKSA, op, &req, sizeof(req));
+}
+
+static int
+wpa_driver_bsd_add_pmkid(void *priv, struct wpa_pmkid_params *params)
+{
+	return wpa_driver_bsd_pmkid(priv, IEEE80211_PMKSA_ADD, params);
+}
+
+static int
+wpa_driver_bsd_remove_pmkid(void *priv, struct wpa_pmkid_params *params)
+{
+	return wpa_driver_bsd_pmkid(priv, IEEE80211_PMKSA_DEL, params);
+}
+
+static int
+wpa_driver_bsd_flush_pmkid(void *priv)
+{
+	return wpa_driver_bsd_pmkid(priv, IEEE80211_PMKSA_FLUSH, NULL);
+}
