+/* report the association, with the request's elements when the driver has them */
+static void
+bsd_assoc_event(struct bsd_driver_data *drv)
+{
+	union wpa_event_data event;
+	struct ieee80211req ireq;
+	u8 ies[512];
+
+	os_memset(&ireq, 0, sizeof(ireq));
+	os_strlcpy(ireq.i_name, drv->ifname, sizeof(ireq.i_name));
+	ireq.i_type = IEEE80211_IOC_ASSOC_REQ_IE;
+	ireq.i_len = sizeof(ies);
+	ireq.i_data = ies;
+	if (ioctl(drv->global->sock, SIOCG80211, &ireq) < 0 ||
+	    ireq.i_len <= 0 || ireq.i_len > (int) sizeof(ies)) {
+		wpa_supplicant_event(drv->ctx, EVENT_ASSOC, NULL);
+		return;
+	}
+	wpa_hexdump(MSG_DEBUG, "BSD: association request elements",
+		    ies, ireq.i_len);
+	os_memset(&event, 0, sizeof(event));
+	event.assoc_info.req_ies = ies;
+	event.assoc_info.req_ies_len = ireq.i_len;
+	wpa_supplicant_event(drv->ctx, EVENT_ASSOC, &event);
+}
+
