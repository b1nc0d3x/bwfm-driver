+				extauth->iev_action == IEEE80211_EXTAUTH_ABORT ?
+				EXT_AUTH_ABORT : EXT_AUTH_START;
+			event.external_auth.bssid = extauth->iev_bssid;
+			event.external_auth.ssid = extauth->iev_ssid;
+			event.external_auth.ssid_len =
+				extauth->iev_ssid_len >
+				sizeof(extauth->iev_ssid) ?
+				sizeof(extauth->iev_ssid) :
+				extauth->iev_ssid_len;
+			event.external_auth.key_mgmt_suite =
+				extauth->iev_key_mgmt;
+			wpa_supplicant_event(drv->ctx, EVENT_EXTERNAL_AUTH,
+					     &event);
+			break;
+		case RTM_IEEE80211_MGMT_RX:
+			if ((size_t) n < sizeof(*ifan) + sizeof(*mgmt_rx))
+				break;
+			mgmt_rx = (struct ieee80211_mgmt_rx_event *) &ifan[1];
+			if (mgmt_rx->iev_len >
+			    (size_t) n - sizeof(*ifan) - sizeof(*mgmt_rx)) {
+				wpa_printf(MSG_DEBUG,
+					   "Management frame of %u bytes "
+					   "truncated; dropped",
+					   mgmt_rx->iev_len);
+				break;
+			}
+			event.rx_mgmt.frame = (const u8 *) &mgmt_rx[1];
+			event.rx_mgmt.frame_len = mgmt_rx->iev_len;
+			event.rx_mgmt.freq = mgmt_rx->iev_freq;
+			event.rx_mgmt.ssi_signal = mgmt_rx->iev_rssi;
+			wpa_supplicant_event(drv->ctx, EVENT_RX_MGMT, &event);
+			break;
+		case RTM_IEEE80211_ASSOC_REJECT:
+			if (drv->is_ap ||
+			    (size_t) n < sizeof(*ifan) + sizeof(*assoc_rej))
+				break;
