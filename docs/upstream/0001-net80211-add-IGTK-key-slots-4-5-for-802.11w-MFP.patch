From c0dede1e0d1e0d1e0d1e0d1e0d1e0d1e0d1e0d1e Mon Sep 17 00:00:00 2001
From: Kyle Crenshaw <b1nc0d3x@gmail.com>
Date: Tue, 29 Jul 2026 22:00:00 -0400
Subject: [PATCH] net80211: add IGTK key slots 4/5 for 802.11w MFP

net80211 rejects any setkey with kid >= IEEE80211_WEP_NKID at
ieee80211_ioctl.c:1206, so wpa_supplicant's install of a BIP-CMAC-128
IGTK fails with EINVAL and MFP can never complete the 4-way.  Extend
iv_nw_keys[] to cover the two IGTK slots, share the same alloc /
lookup path as WEP/GTK, and route the setkey/getkey/delkey bound
checks accordingly.

Uses the same names as the WIP net80211 reviews on this area
(D45887 / D46505 / D46668) so this is really the minimal subset of
D46668 with the driver-side diffs (ath, rtwn) stripped out.

Deliberately narrow.  This patch adds:
  - IEEE80211_IGTK_NKID (2), IEEE80211_IGTK_KID_BASE (4),
    IEEE80211_MAX_NKID (WEP_NKID + IGTK_NKID = 6), and a
    IEEE80211_KEY_IS_IGTK(kid) macro.
  - iv_nw_keys[] grows from WEP_NKID to MAX_NKID slots.  All existing
    pointer arithmetic against &vap->iv_nw_keys[0] stays valid
    (single contiguous allocation, no UB).
  - Bound checks in the key-install ioctl paths (setkey / getkey /
    delkey / delglobalkeys / is_key_global / crypto_resetkey init /
    ddb dumper / resume-time reinstall) move from WEP_NKID to
    MAX_NKID.
  - IEEE80211_IOC_WEPKEY, IEEE80211_IOC_WEPTXKEY, and
    IEEE80211_IOC_NUMWEPKEYS stay at WEP_NKID -- those paths carry
    WEP semantics and slots 4/5 are not WEP.

Not touched, on purpose:
  - The software wlan_bip_cmac cipher module.  Only needed for softmac
    drivers doing BIP in-host; FullMAC + fw-side BIP works without.
  - MMIC element ID handling from D46505.
  - Driver-side auditing (ath, rtwn key allocators skipping IGTK):
    each maintainer's call once the ABI change lands.
  - IGTK rekey / IPN replay counter validation.
  - The wpa_supplicant driver_bsd shim.  I initially thought that
    needed an added IEEE80211_C_ PSK-SHA256 capability bit, but the
    AKM selection in wpa_supplicant.c:1876 comes out of ie.key_mgmt
    & ssid->key_mgmt (AP beacon intersected with the network block),
    not capa.key_mgmt.  MFP gating is separate, in wpas_get_ssid_pmf
    on drv_enc & WPA_DRIVER_CAPA_ENC_BIP, which unpatched driver_bsd
    already sets from IEEE80211_CRYPTO_BIP_CMAC_128.  So MFP works
    once (a) the driver advertises BIP-CMAC-128 in ic_cryptocaps and
    (b) the wpa_supplicant network block lists WPA-PSK-SHA256 in
    key_mgmt.  No shim patch needed.

ABI note.  sizeof(struct ieee80211_key) is 216 bytes on LP64, so
iv_nw_keys[] grows by 432 bytes and struct ieee80211vap grows by the
same 432 bytes.  Modules that embed a full ieee80211vap must be
rebuilt against a matching kernel; ones that only carry a pointer are
unaffected.  D46668 makes the same tradeoff.

Tested on fbsdmac (MBP11,4, BCM43602 + fw v7.35.177.61) against
Ubuntu hostapd v2.10 MFP-optional (ieee80211w=1,
wpa_key_mgmt=WPA-PSK WPA-PSK-SHA256, group_mgmt_cipher=AES-128-CMAC):

  wpa_state=COMPLETED at t=2 s, key_mgmt=WPA2-PSK-SHA256, pmf=1
  DHCPACK from 10.99.0.1, bound 10.99.0.17
  3/3 pings, 1.5-8.7 ms
  brcm_pci0: fmop_set_key: IGTK idx=4 algo=4 rc=0

5/5 rapid ifconfig down/up + wpa_supplicant restart cycles all
complete in 3-4 s each with MFP renegotiated + IGTK re-installed on
every cycle.  No panics, no wedges.

Reaching that state on BCM43602 also needed a companion one-shot
wpa_supplicant fallback for wpa_compare_rsn_ie -- fw auto-expands the
parsed beacon RSN IE with an implicit PMKID+group_mgmt suffix when
MFPC is set in RSN caps, so the byte-exact compare against the
verbatim M3 IE fires reason=17 right after IGTK material arrives.
Not part of this patch, posting separately.

Full driver context: https://github.com/b1nc0d3x/brcm-driver.git
---
 sys/net80211/ieee80211.c        |  2 +-
 sys/net80211/ieee80211.h        |  7 +++++++
 sys/net80211/ieee80211_crypto.c |  6 +++---
 sys/net80211/ieee80211_ddb.c    |  2 +-
 sys/net80211/ieee80211_ioctl.c  |  6 +++---
 sys/net80211/ieee80211_var.h    |  2 +-
 6 files changed, 16 insertions(+), 9 deletions(-)

diff --git a/sys/net80211/ieee80211.c b/sys/net80211/ieee80211.c
index 0000000..0000001 100644
--- a/sys/net80211/ieee80211.c
+++ b/sys/net80211/ieee80211.c
@@ -2702,7 +2702,7 @@ ieee80211_is_key_global(const struct ieee80211vap *vap,
     const struct ieee80211_key *key)
 {
 	return (&vap->iv_nw_keys[0] <= key &&
-	    key < &vap->iv_nw_keys[IEEE80211_WEP_NKID]);
+	    key < &vap->iv_nw_keys[IEEE80211_MAX_NKID]);
 }

 /*
diff --git a/sys/net80211/ieee80211.h b/sys/net80211/ieee80211.h
index 0000000..0000001 100644
--- a/sys/net80211/ieee80211.h
+++ b/sys/net80211/ieee80211.h
@@ -2049,6 +2049,13 @@
 					 IEEE80211_WEP_KIDLEN + \
 					 IEEE80211_WEP_CRCLEN)
 #define	IEEE80211_WEP_NKID		4	/* number of key ids */
+#define	IEEE80211_IGTK_NKID		2	/* MFP IGTK key ids (4,5) */
+#define	IEEE80211_IGTK_KID_BASE		IEEE80211_WEP_NKID
+#define	IEEE80211_MAX_NKID		(IEEE80211_WEP_NKID +		\
+					 IEEE80211_IGTK_NKID)
+#define	IEEE80211_KEY_IS_IGTK(kid)					\
+	((kid) >= IEEE80211_IGTK_KID_BASE &&				\
+	 (kid) < IEEE80211_IGTK_KID_BASE + IEEE80211_IGTK_NKID)

 /*
  * 802.11i defines an extended IV for use with non-WEP ciphers.
diff --git a/sys/net80211/ieee80211_crypto.c b/sys/net80211/ieee80211_crypto.c
index 0000000..0000001 100644
--- a/sys/net80211/ieee80211_crypto.c
+++ b/sys/net80211/ieee80211_crypto.c
@@ -229,9 +229,9 @@
 	int i;

 	/* NB: we assume everything is pre-zero'd */
-	vap->iv_max_keyix = IEEE80211_WEP_NKID;
+	vap->iv_max_keyix = IEEE80211_MAX_NKID;
 	vap->iv_def_txkey = IEEE80211_KEYIX_NONE;
-	for (i = 0; i < IEEE80211_WEP_NKID; i++)
+	for (i = 0; i < IEEE80211_MAX_NKID; i++)
 		ieee80211_crypto_resetkey(vap, &vap->iv_nw_keys[i],
 			IEEE80211_KEYIX_NONE);

@@ -562,7 +562,7 @@
 	int i;

 	ieee80211_key_update_begin(vap);
-	for (i = 0; i < IEEE80211_WEP_NKID; i++)
+	for (i = 0; i < IEEE80211_MAX_NKID; i++)
 		(void) _ieee80211_crypto_delkey(vap, &vap->iv_nw_keys[i]);
 	ieee80211_key_update_end(vap);
 }
@@ -889,7 +889,7 @@
 	TAILQ_FOREACH(vap, &ic->ic_vaps, iv_next) {
 		if (vap->iv_state != IEEE80211_S_RUN)
 			continue;
-		for (i = 0; i < IEEE80211_WEP_NKID; i++) {
+		for (i = 0; i < IEEE80211_MAX_NKID; i++) {
 			const struct ieee80211_key *k = &vap->iv_nw_keys[i];
 			if (k->wk_flags & IEEE80211_KEY_DEVKEY)
 				dev_key_set(vap, k);
diff --git a/sys/net80211/ieee80211_ddb.c b/sys/net80211/ieee80211_ddb.c
index 0000000..0000001 100644
--- a/sys/net80211/ieee80211_ddb.c
+++ b/sys/net80211/ieee80211_ddb.c
@@ -606,7 +606,7 @@
 	db_printf("\tmax_keyix %u", vap->iv_max_keyix);
 	db_printf(" def_txkey %d", vap->iv_def_txkey);
 	db_printf("\n");
-	for (i = 0; i < IEEE80211_WEP_NKID; i++)
+	for (i = 0; i < IEEE80211_MAX_NKID; i++)
 		_db_show_key("\tnw_keys[%u]", i, &vap->iv_nw_keys[i]);

 	db_printf("\tauth %p(%s)", vap->iv_auth, vap->iv_auth->ia_name);
diff --git a/sys/net80211/ieee80211_ioctl.c b/sys/net80211/ieee80211_ioctl.c
index 0000000..0000001 100644
--- a/sys/net80211/ieee80211_ioctl.c
+++ b/sys/net80211/ieee80211_ioctl.c
@@ -93,7 +93,7 @@
 			return ENOENT;
 		wk = &ni->ni_ucastkey;
 	} else {
-		if (kid >= IEEE80211_WEP_NKID)
+		if (kid >= IEEE80211_MAX_NKID)
 			return EINVAL;
 		wk = &vap->iv_nw_keys[kid];
 		IEEE80211_ADDR_COPY(&ik.ik_macaddr, vap->iv_bss->ni_macaddr);
@@ -1203,7 +1203,7 @@
 		}
 		wk = &ni->ni_ucastkey;
 	} else {
-		if (kid >= IEEE80211_WEP_NKID)
+		if (kid >= IEEE80211_MAX_NKID)
 			return EINVAL;
 		wk = &vap->iv_nw_keys[kid];
 		/*
@@ -1280,7 +1280,7 @@
 		ieee80211_node_delucastkey(ni);
 		ieee80211_free_node(ni);
 	} else {
-		if (kid >= IEEE80211_WEP_NKID)
+		if (kid >= IEEE80211_MAX_NKID)
 			return EINVAL;
 		/* XXX error return */
 		ieee80211_crypto_delkey(vap, &vap->iv_nw_keys[kid]);
diff --git a/sys/net80211/ieee80211_var.h b/sys/net80211/ieee80211_var.h
index 0000000..0000001 100644
--- a/sys/net80211/ieee80211_var.h
+++ b/sys/net80211/ieee80211_var.h
@@ -511,7 +511,7 @@
 	/* Key management */
 	uint16_t		iv_max_keyix;	/* max h/w key index */
 	ieee80211_keyix		iv_def_txkey;	/* default/group tx key index */
-	struct ieee80211_key	iv_nw_keys[IEEE80211_WEP_NKID];
+	struct ieee80211_key	iv_nw_keys[IEEE80211_MAX_NKID];
 	int			(*iv_key_alloc)(struct ieee80211vap *,
 				    struct ieee80211_key *,
 				    ieee80211_keyix *, ieee80211_keyix *);
--
2.44.0

